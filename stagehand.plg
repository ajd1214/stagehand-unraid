<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "stagehand">
<!ENTITY author    "ajd1214">
<!ENTITY version   "2026.11.21">
<!ENTITY launch    "Utilities/Stagehand">
<!ENTITY gitURL    "https://raw.githubusercontent.com/ajd1214/stagehand-unraid/main">
<!ENTITY pluginURL "&gitURL;/stagehand.plg">
<!ENTITY plgPATH   "/boot/config/plugins/&name;">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
<!ENTITY pkgSHA    "e5557cc9c8b8fd48808767a2073ab6bb81c6990e6c8b66bdaada31baffc58843">
<!ENTITY gdbPKG    "gdb-15.2-x86_64-3">
<!ENTITY gdbSHA    "88f0417bb73d1fc6c0f6a955f0ff6b3667a17698162ba0340079c1cf9628c4a1">
]>
<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="&launch;"
        pluginURL="&pluginURL;"
        icon="film"
        min="7.0.0">

<CHANGES>
###2026.11.21
- Now playing: while something plays, logs one PLAYING line per stream every 5 minutes (setting "Now-playing log interval", 0 = off) saying whether it is read from the SSD pool or an array disk. Shown on the Status section too. Read from /proc only: no extra media-server calls, never wakes a disk
- Optional media-server user names in those lines ("Show user names", default no)
- clean now waits up to 2 minutes for a running run instead of silently skipping when both start at :17, and logs if it still cannot run

###2026.11.16b
- Default settings are now generic examples (only used on a new install; existing settings are kept)

###2026.11.16
- Does nothing until Unraid has mounted the user shares at /mnt/user. Before, a run at boot (before the array started) could create /mnt/user/appdata/stagehand and /mnt/user/system/mover as plain folders, which stops Unraid from mounting the user shares at all

###2026.10.24e
- A title already playing from the SSD no longer touches array disks (no array stat, no folder listing every minute)
- Next episodes are topped up only when nothing later is cached yet, at most once per 6 hours per title
- New setting: Touch array disks only at (hours), ARRAY_WAKE_HOURS, for releases and leftover checks

###2026.10.24d
- Sonarr/Radarr leftover check now works when a container sees the library under more than one path (for example /tv and /mnt/user/tv)

###2026.10.24c
- New: Release all now button (release-all command) empties Stagehand's pool copies, ignoring keep time. Same safety checks as clean. Works while paused.

###2026.10.24b
- Leftover array files are now checked against up to six Sonarr/Radarr instances
- Optional auto-delete of confirmed leftovers (off by default, with safety checks and a wait)
- Self-check lists each Sonarr/Radarr and whether it answers
- Settings: removed the one-choice leftover setting, filled in missing help text

###2026.10.24a
- "Also copy" can now be a number, rest (every later episode) or season (whole season folder)
- Pool safety split: read-only always stops copying; new filesystem errors and disk I/O errors are separate switches with a pause length
- Up to three media servers at once (any mix of Plex, Jellyfin, Emby)
- Option to remove empty pool folders after release
- Clearer help text; every field shows its default

###2026.10.24
- First plugin release: settings, log and lists pages; schedule; pause/resume; Mover Tuning button
- Copies the playing file to the pool, live-switches playback, copies next episode and subtitles
- Releases pool copies only with a verified array twin; reports leftover array files
</CHANGES>

<!-- Stagehand package -->
<FILE Name="&plgPATH;/&name;-&version;.txz" Run="upgradepkg --install-new">
<URL>&gitURL;/packages/&name;-&version;.txz</URL>
<SHA256>&pkgSHA;</SHA256>
</FILE>

<!-- gdb for the live switch (installed only if not already present) -->
<FILE Name="&plgPATH;/&gdbPKG;.txz">
<URL>&gitURL;/packages/&gdbPKG;.txz</URL>
<SHA256>&gdbSHA;</SHA256>
</FILE>

<!-- install / every boot -->
<FILE Run="/bin/bash">
<INLINE>
P=&plgPATH;
E=&emhttp;
mkdir -p "$P"
[ -f "$P/stagehand.cfg" ] || cp "$E/default.cfg" "$P/stagehand.cfg"
chmod 755 "$E/stagehand.sh"
if ! command -v gdb >/dev/null 2>&amp;1; then
  installpkg "$P/&gdbPKG;.txz" >/dev/null &amp;&amp; touch "$P/.gdb-installed-by-stagehand" &amp;&amp; echo "installed gdb"
fi
# leftovers from the Stage 1 manual install
rm -f "$P/stagehand.sh"
# old package versions
for f in "$P"/&name;-*.txz; do [ "$f" = "$P/&name;-&version;.txz" ] || rm -f "$f"; done
bash "$E/stagehand.sh" apply
echo "Stagehand &version; installed. Settings: Utilities > Stagehand"
</INLINE>
</FILE>

<!-- uninstall -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
P=&plgPATH;
E=&emhttp;
[ -f "$E/stagehand.sh" ] &amp;&amp; bash "$E/stagehand.sh" uninstall-cleanup
rm -f "$P/stagehand.cron"
[ -x /usr/local/sbin/update_cron ] &amp;&amp; /usr/local/sbin/update_cron
removepkg "$P/&name;-&version;.txz" >/dev/null 2>&amp;1
if [ -f "$P/.gdb-installed-by-stagehand" ] &amp;&amp; [ ! -f /boot/config/plugins/cache-mover.plg ]; then
  removepkg &gdbPKG; >/dev/null 2>&amp;1
fi
rm -f "$P"/*.txz "$P/.gdb-installed-by-stagehand"
echo "Stagehand removed. Settings kept in $P/stagehand.cfg. State and log kept in the state folder."
</INLINE>
</FILE>

</PLUGIN>
